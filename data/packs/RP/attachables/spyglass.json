{
  "format_version": "1.10.0",
  "minecraft:attachable": {
    "description": {
      "identifier": "minecraft:spyglass",
      "materials": {
        "default": "entity_alphatest",
        "enchanted": "entity_alphatest_glint"
      },
      "textures": {
        "default": "textures/entity/spyglass",
        "enchanted": "textures/misc/enchanted_item_glint"
      },
      "geometry": {
        "default": "geometry.spyglass"
      },
      "animations": {
        "holding": "animation.spyglass.holding",
        "scoping": "animation.spyglass.scoping"
      },
      "scripts": {
        "animate": [
          {
            "holding": "!(c.item_slot == 'main_hand' ? (q.main_hand_item_use_duration > 0.0f && !(c.owning_entity->v.offhand_item_use > 0.0)) : c.owning_entity->v.offhand_item_use > 0.0)"
          },
          {
            "scoping": "!c.is_first_person && (c.item_slot == 'main_hand' ? (q.main_hand_item_use_duration > 0.0f && !(c.owning_entity->v.offhand_item_use > 0.0)) : c.owning_entity->v.offhand_item_use > 0.0)"
          }
        ]
      },
      "render_controllers": [ "controller.render.item_default" ]
    }
  }
}
